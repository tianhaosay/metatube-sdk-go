{
    "EditorTitle": "MetaTube",

    "Server": "http://localhost:8080",
    "Token": "",

    "EnableAutoUpdate": true,
    "EnableCollections": true,
    "EnableDirectors": true,
    "EnableRatings": true,
    "EnableTrailers": false,
